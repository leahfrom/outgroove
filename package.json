{
  "name": "outgroove",
  "version": "0.17.2",
  "description": "Local-first music library and safe DAP sync",
  "author": "Outgroove contributors",
  "license": "GPL-3.0-or-later",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "npm@11.18.0",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx tests/e2e/packaged-smoke.ts",
    "inspect:package": "node --import tsx scripts/packaged-inspection.ts",
    "test:exfat": "node --import tsx scripts/filesystem-conformance.ts",
    "benchmark:library": "node --import tsx scripts/library-benchmark.ts",
    "benchmark:library:100k": "npm run benchmark:library -- --files 100000",
    "benchmark:metadata": "node --import tsx scripts/library-benchmark.ts --real-files 1000",
    "fixtures:generate": "tsx scripts/generate-audio-fixtures.ts",
    "version:check": "node --import tsx scripts/gitflow.ts check-version",
    "flow:feature": "node --import tsx scripts/gitflow.ts start-feature",
    "flow:release": "node --import tsx scripts/gitflow.ts start-release",
    "flow:hotfix": "node --import tsx scripts/gitflow.ts start-hotfix",
    "flow:validate-pr": "node --import tsx scripts/gitflow.ts validate-pr",
    "flow:validate-release-tag": "node --import tsx scripts/gitflow.ts validate-release-tag",
    "release:tag": "npm run verify && node --import tsx scripts/gitflow.ts tag-release",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run version:check && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@akabeko/music-metadata-editor": "^1.0.1",
    "better-sqlite3": "^13.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "music-metadata": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "taglib-wasm": "^1.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/notarize": "^2.5.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.1.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.0": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.28.1": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
